{
  "name": "@heder1/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node --env-file=.env --import tsx --watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node --env-file=.env dist/server.js",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "demo:paid-resource": "node --env-file=.env --import tsx src/paid-resource-client.ts",
    "test": "node --import tsx --test src/*.test.ts"
  },
  "dependencies": {
    "@x402/core": "^2.24.0",
    "@x402/fetch": "^2.24.0",
    "@x402/hedera": "^2.24.0",
    "fastify": "^5.6.1"
  },
  "devDependencies": {
    "@types/node": "^24.7.2",
    "tsx": "^4.20.5",
    "typescript": "^5.9.3"
  }
}
