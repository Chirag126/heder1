# Hedera testnet only. Copy to .env and replace payer placeholders locally.
HEDERA_NETWORK=testnet
HEDERA_CLIENT_ACCOUNT_ID=0.0.YOUR_TESTNET_PAYER_ACCOUNT
HEDERA_CLIENT_PRIVATE_KEY=YOUR_TESTNET_ECDSA_PRIVATE_KEY

# Public receiver account ID for the testnet payment demo.
HEDERA_RECEIVER_ACCOUNT_ID=0.0.11044329

# Facilitator for x402 v2 Hedera testnet; override only with a trusted compatible facilitator.
HEDERA_X402_FACILITATOR_URL=https://api.testnet.blocky402.com

# Explicit local opt-in. This enables an endpoint that can send 0.001 HBAR.
# Never enable in production or expose the API publicly.
HEDERA_X402_DEMO_ENABLED=false

# Phase 2 autonomous agent is disabled by default. Local testnet only.
# One POST /api/agent/run may automatically pay up to 0.001 HBAR for the exact allowlisted local resource.
HEDERA_AGENT_ENABLED=false
HEDERA_X402_PAID_RESOURCE_URL=http://127.0.0.1:4000/api/x402/paid-resource

# Optional local API settings
PORT=4000
HOST=127.0.0.1
